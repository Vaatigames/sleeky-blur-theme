---
import "@fontsource-variable/albert-sans";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
---

<label for="my-drawer-3" aria-label="close sidebar" class="drawer-overlay"
></label>

<ul class="menu p-4 w-80 min-h-full bg-base-300 pt-20">
  <li>
    <a class="p-2 mt-2 bg-base-100 text-lg" href="/"
      ><Icon name="tabler:heart" /> Par Nous</a
    >
  </li>
  <li>
    <a href="/projet/ticket">
      <Image
        src="/img/vaaticket.png"
        height="18"
        width="18"
        alt="Logo Vaaticket"
      />
      Vaaticket
    </a>
  </li>
  <li>
    <a href="/projet/links">
      <Image src="/img/dclinks.png" height="18" width="18" alt="Logo DCLinks" />
      DCLinks
    </a>
  </li>
</ul>

<style is:inline>
  .drawer-overlay {
    backdrop-filter: none;
    transition: backdrop-filter 0.4s ease;
  }
  .drawer-toggle:checked ~ .drawer-side > .drawer-overlay {
    background-color: rgba(0, 0, 0, 0) !important;
    backdrop-filter: blur(4px);
    transition: backdrop-filter 0.4s ease;
  }
</style>
