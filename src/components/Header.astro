---
import "@fontsource-variable/albert-sans";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
---

<div
  class="navbar fixed top-0 border-b backdrop-blur border-base-300 z-30 bg-black/5 dark:bg-white/10">
  <div class="navbar-start">
    <label
      for="my-drawer-3"
      aria-label="open sidebar"
      class="btn btn-square btn-ghost lg:hidden">
      <Icon name="tabler:menu-2" class="text-xl"/>
    </label>
    <a class="ml-2 text-xl" href="/">
      <Image
        class="h-9 hover:h-10 w-auto transition-all duration-300"
        src="/img/vaati1.png"
        alt="Vaatigame's Logo"
        width="144"
        height="36"
      />
    </a>
  </div>
  <div class="navbar-center hidden lg:flex gap-x-6">
    <div class="dropdown">
      <div
        tabindex="0"
        role="button"
        class="grid grid-flow-col link link-hover items-center gap-x-2">
        <Icon name="tabler:heart" /> Services
      </div>
      <ul
        tabindex="0"
        class="dropdown-content menu bg-base-100 rounded-box z-[1] w-36 p-2 mt-6">
        <li>
          <a href="/projet/ticket">
            <Image
              src="/img/vaaticket.png"
              height="18"
              width="18"
              alt="Logo Vaaticket"
            />
            Vaaticket
          </a>
        </li>
        <li>
          <a href="/projet/links">
            <Image
              src="/img/dclinks.png"
              height="18"
              width="18"
              alt="Logo DCLinks"
            />
            DCLinks
          </a>
        </li>
      </ul>
    </div>
    <div class="dropdown">
      <div
        tabindex="0"
        role="button"
        class="grid grid-flow-col link link-hover items-center gap-x-2">
        <Icon name="tabler:user" /> Inscriptions
      </div>
      <ul
        tabindex="0"
        class="dropdown-content menu bg-base-100 rounded-box z-[1] w-40 p-2 mt-6">
        <li>
          <a href="/conditions">
            <Icon name="tabler:news" />
            Conditions
          </a>
        </li>
        <li>
          <a href="/form">
            <Icon name="tabler:input-spark" />
            Formulaire
            <Icon name="tabler:arrow-big-up-lines" />
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="navbar-end">
    <div class="inline-block relative mr-2 w-10">
      <button
        data-toggle-theme="dracula,light"
        class="relative flex items-center justify-center w-10 h-10 btn-ghost rounded">
        <!-- First SVG icon (bottom layer) -->
        <svg
          class="opacity-0 dark:opacity-100 absolute fill-current w-6 h-6 transition-all duration-500"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          ><path
            d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
          ></path></svg
        >

        <!-- Second SVG icon (top layer) -->
        <svg
          class="absolute dark:opacity-0 opacity-100 fill-current w-6 h-6 transition-all duration-500"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          ><path
            d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
          ></path></svg
        >
      </button>
    </div>
    <a href="https://panel.vaatigames.ovh" class="flex items-center btn bg-gradient-to-r from-primary-light via-primary-medium to-primary-dark">
      <Icon name="tabler:app-window" class="text-2xl"/>
      <span class="ml-2">Panel</span>
    </a>
  </div>
</div>
