---
import Layout from "../layouts/Captcha.astro";
import { Icon } from "astro-icon/components";

const FORM_URL = import.meta.env.DISCORD_WEBHOOK;
const CAPTCHA_SITE_KEY = import.meta.env.CLOUDFLARE_CAPTCHA_KEY;
---

<Layout title="Formulaire avancé">
  <form class="w-full md:w-1/2 mx-auto p-6 pt-20" id="mainForm">
    <h1 class="text-xl lg:text-3x font-bold my-3">Profil</h1>
    <!-- Champ Texte -->
    <div class="form-control">
      <label class="label">
        <span class="label-text">Nom complet</span>
      </label>
      <input
        type="text"
        name="name"
        placeholder="Votre nom"
        class="input input-bordered"
        required
        minlength="3"
      />
    </div>

    <!-- Email avec validation -->
    <div class="form-control">
      <label class="label">
        <span class="label-text">Email</span>
      </label>
      <input
        type="email"
        name="email"
        placeholder="email@exemple.com"
        class="input input-bordered"
        required
        pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$"
      />
    </div>

    <div class="form-control">
      <label class="label">
        <span class="label-text">Pseudo Discord</span>
      </label>
      <input
        type="text"
        name="discord"
        placeholder="@funasitien"
        class="input input-bordered"
        required
        minlength="3"
      />
      <label class="label">
        <span class="label-text-alt">N'oubliez pas de rejoindre notre <a href="https://dsc.vaatugames.ovh" target="_blank" class="link">serveur discord</a> !</span>
      </label>
    </div>

    <h1 class="text-xl lg:text-3x font-bold my-3">Projet</h1>

    <div class="form-control">
      <label class="label">
        <span class="label-text">Nom complet</span>
      </label>
      <input
        type="text"
        name="fullname"
        placeholder="Votre nom"
        class="input input-bordered"
        required
        minlength="3"
      />
    </div>

    <!-- Dropdown personnalisé avec icônes -->
    <div class="relative mt-2">
      <button
        id="dropdownButton"
        type="button"
        class="input input-bordered w-full flex justify-between items-center"
      >
        <span id="selectedOption">Type de serveur</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 9l-7.5 7.5L4.5 9"></path>
        </svg>
      </button>

      <div
        id="dropdownMenu"
        class="absolute w-full shadow-lg rounded-lg mt-2 textarea textarea-bordered hidden"
      >
        <button
          type="button"
          class="dropdown-item btn btn-ghost justify-left flex items-center p-2 gap-2 w-full"
          data-value="jeu"
        >
          <Icon name="tabler:brand-minecraft" />
          Jeu
        </button>
        <button
          type="button"
          class="dropdown-item btn btn-ghost justify-left flex items-center p-2 gap-2 w-full"
          data-value="code"
        >
          <Icon name="tabler:brand-python" />
          Code
        </button>
        <button
          type="button"
          class="dropdown-item btn btn-ghost justify-left flex items-center p-2 gap-2 w-full"
          data-value="option1"
        >
          <Icon name="tabler:tools" />
          Outil
        </button>
        <button
          type="button"
          class="dropdown-item btn btn-ghost justify-left flex items-center p-2 gap-2 w-full"
          data-value="autre"
        >
          <Icon name="tabler:settings" />
          Autre
        </button>
      </div>

      <input type="hidden" name="customDropdown" id="dropdownInput" />
    </div>

    <label class="form-control">
      <div class="label">
        <span class="label-text">Présentation de votre projet</span>
      </div>
      <textarea class="textarea textarea-bordered h-24" placeholder="DEMOCRAFT est un serveur mini-jeux crossplay..."></textarea>
      <div class="label">
        <span class="label-text-alt">Soyez créatif & précis !</span>
      </div>
    </label>

    <div class="form-control">
      <label class="label cursor-pointer">
        <span class="label-text">Évènement (-1 mois)</span>
        <input
          type="radio"
          name="radio-10"
          class="radio checked:bg-violet-500"
          checked="checked"
        />
      </label>
    </div>
    <div class="form-control">
      <label class="label cursor-pointer">
        <span class="label-text">Évènement (+1 mois)</span>
        <input
          type="radio"
          name="radio-10"
          class="radio checked:bg-blue-500"
          checked="checked"
        />
      </label>
    </div>
    <label class="label cursor-pointer">
      <span class="label-text">Définitif</span>
      <input
        type="radio"
        name="radio-10"
        class="radio checked:bg-red-500"
        checked="checked"
      />
    </label>


  <div class="form-control">
    <label class="label">
      <span class="label-text">Slots</span>
    </label>
    <input type="range" min="1" max="10" value="1" class="range" step="1" />
    <div class="flex w-full justify-between px-2 text-xs mb-2">
      <span>1</span>
      <span>2</span>
      <span>3</span>
      <span>4</span>
      <span>5</span>
      <span>6</span>
      <span class="max-sm:hidden">7</span>
      <span class="max-sm:hidden">8</span>
      <a href="/conditions#slots" class="link">C'est quoi un slot ?</a>
    </div>
  </div>

  <!-- CAPTCHA Cloudflare -->
  <div
    class="cf-turnstile w-full flex justify-center items-center"
    data-sitekey={CAPTCHA_SITE_KEY}
    data-callback="captchaSuccess"
    data-language="fr"
  >
  </div>

  <!-- Messages d'erreur/succès -->
  <div id="message" class="mt-4 hidden"></div>

  <!-- Bouton de soumission -->
  <button
    type="submit"
    class="btn btn-primary mt-4 w-full"
    disabled
    id="submitBtn"
  >
    Envoyer le formulaire
  </button>
</Layout>

<script is:inline>
  // Validation et soumission
  const FORM_URL = ${JSON.stringify(FORM_URL)};
  const form = document.getElementById("mainForm");
  const submitBtn = document.getElementById("submitBtn");
  let captchaValid = false;
  let errorMessage = "";

  // Called by your captcha mechanism
  function captchaSuccess() {
    captchaValid = true;
    submitBtn.disabled = !form.checkValidity() || !captchaValid;
  }

  // Use async/await in the submit handler
  async function handleSubmit(e) {
    e.preventDefault();

    if (!form.checkValidity() || !captchaValid) {
      showMessage("Veuillez remplir tous les champs correctement", "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = "Envoi en cours...";

    const formData = new FormData(form);
    const payload = {
      content: "Nouvelle soumission de formulaire",
      embeds: [
        {
          title: "Nouveau formulaire soumis",
        },
      ],
    };

    try {
      const response = await fetch(`${FORM_URL}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (response.ok) {
        showMessage("Formulaire envoyé avec succès !", "success");
        form.reset();
      } else {
        errorMessage = await response.text();
        throw new Error(`Erreur ${response.status}: ${errorMessage}`);
      }
    } catch (error) {
      showMessage(`Erreur lors de l'envoi: ${error}`, "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = "Envoyer le formulaire";
    }
  }

  form.addEventListener("submit", handleSubmit);

  function showMessage(text, type) {
    const messageEl = document.getElementById("message");
    messageEl.className = `alert alert-${type} mt-4`;
    messageEl.textContent = text;
    messageEl.classList.remove("hidden");
  }

  // Validation en temps réel
  form.addEventListener("input", () => {
    submitBtn.disabled = !form.checkValidity() || !captchaValid;
  });

  document.addEventListener("DOMContentLoaded", () => {
    const dropdownButton = document.getElementById("dropdownButton");
    const dropdownMenu = document.getElementById("dropdownMenu");
    const dropdownInput = document.getElementById("dropdownInput");
    const selectedOption = document.getElementById("selectedOption");

    dropdownButton.addEventListener("click", () => {
      dropdownMenu.classList.toggle("hidden");
    });

    dropdownMenu.querySelectorAll(".dropdown-item").forEach((item) => {
      item.addEventListener("click", () => {
        selectedOption.textContent = item.textContent.trim();
        dropdownInput.value = item.dataset.value;
        dropdownMenu.classList.add("hidden");
      });
    });

    function checkFormValidity() {
      submitBtn.disabled = !form.checkValidity() || !captchaValid;
    }

    form.addEventListener("input", checkFormValidity);
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
