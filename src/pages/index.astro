---
import Layout from "../layouts/Layout.astro";
import FactGrid from "../components/FactGrid.astro";
import Team from "../components/Team.astro";
import Testimonie from "../components/Testimonie.astro";

import "@fontsource-variable/albert-sans";
import { Icon } from "astro-icon/components";
---

<Layout title="Vaatigames">
  <div class="hero min-h-screen transition-all duration-300">
    <div class="hero-content flex-col lg:flex-row-reverse w-screen">
      <div class="w-full lg:w-1/3 flex lg:justify-end">
        <img
          src="/ai/server1.svg"
          class="max-w-sm rounded-lg opacity-60 hover:opacity-100 transition-all duration-300"
          alt="Server"
        />
      </div>
      <div class="lg:w-2/3">
        <h1 class="text-3xl lg:text-5xl font-bold">
          La qualité et l'efficacité
          <br />
          <span
            class="inline-flex bg-gradient-to-r from-primary-light via-primary-medium to-primary-dark text-transparent bg-clip-text">
            <Icon name="tabler:sparkles" class="mr-1 text-primary-light" />
            sans le prix
            <Icon name="tabler:sparkles" class="ml-1 text-primary-dark" />
          </span>
        </h1>
        <p class="py-6">
          Découvrez Vaatigames, un hébergeur de serveurs de jeux gratuit 💜
          <br />
          Vaatigames, c'est la solution parfaite entre hébergeur de qualité et prix
          exorbitants. Car ici, <b>c'est nous</b> qui payons l'addition !
        </p>
        <a href="/conditions" class="btn btn-ghost">Conditions d'inscriptions</a>
      </div>
    </div>
  </div>
  <FactGrid
    title="Vaatigames c'est quoi ?"
    body="Nous essayons d'être un hébergeur flexible, sans économiser sur les fonctionnalités ou les performances grâce à nos trois catégories de serveurs.."
    items={[
      {
        title: "Multi-Usage",
        description:
          "Vaatigames est compatible avec tous les jeux en lignes disponibles sur le marché. Je vous promet que ça fait beaucoup.",
        icon: "tabler:puzzle",
      },
      {
        title: "Panel Intuitif",
        description:
          "Notre panel est simple d'utilisation - avec des modules pour installer vos plugins & mods en un clic.",
        icon: "tabler:app-window",
      },
      {
        title: "Évolutif",
        description:
          "Grâce à notre système de catégorie hardware, vous pouvez à tout moment changer d'offre et passer à des composants plus performants !",
        icon: "tabler:arrow-big-up-lines",
      },
    ]}
  />
  <div class="flex flex-col justify-center items-center">
  <div class="carousel rounded-box max-sm:max-w-96 w-full md:w-[50rem]">
    <div class="carousel-item max-w-full">
    <Testimonie
      id="item1"
      stars="3"
      body="Nous n'avons pas d'avis pour le moment. Soyez le premier à nous noter !"
    />
    </div>
    <div class="carousel-item max-w-full">
      <Testimonie
        id="item2"
        stars="5"
        body="Nous n'avons pas d'avis pour le moment. Soyez le premier à nous noter !"
      />
      </div>
  </div>
  <div class="flex w-full justify-center gap-2 py-2">
    <a href="#item1" class="btn btn-primary btn-xs w-6">1</a>
    <a href="#item2" class="btn btn-primary btn-xs w-6">2</a>
  </div>
</div>
  <Team />
</Layout>
